{
  "expo": {
    "name": "Ticklane",
    "slug": "ticklane",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ticklane",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/ticklane_ios.icon",
      "bundleIdentifier": "com.ticklane",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#031364",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ticklane"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Este aplicativo solicita acesso às fotos do dispositivo exclusivamente para permitir que o usuário selecione e atualize sua foto de perfil"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#031364",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 100
          },
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 100
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24409d6b-ca27-4046-9dd9-e76857b5fdf5"
      }
    }
  }
}
